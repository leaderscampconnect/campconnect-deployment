FRONTEND_REF=main
FRONTEND_REVISION=6087282b508de3093c8e7258b25151d322bf6d60

EUREKA_REPOSITORY=https://github.com/leaderscampconnect/eureka-server.git
EUREKA_REF=main
EUREKA_REVISION=be0113fb831d0a8610cf412036b503c29edfb5f5
