# Repository refs. The gateway and frontend point at the integration branches
# until the upstream pull requests are merged.
GATEWAY_REPOSITORY=https://github.com/IhebBoughanmi/api-gateway.git
GATEWAY_REF=feat/team-routing-security-swagger
FRONTEND_REPOSITORY=https://github.com/IhebBoughanmi/CampConnectFrontWebDis.git
FRONTEND_REF=feat/api-integration-dashboard

EUREKA_REPOSITORY=https://github.com/leaderscampconnect/eureka-server.git
EUREKA_REF=main
CONFIG_SERVER_REPOSITORY=https://github.com/leaderscampconnect/ConfigServer.git
CONFIG_SERVER_REF=main
USER_SERVICE_REPOSITORY=https://github.com/leaderscampconnect/UserService.git
USER_SERVICE_REF=main
CAMPING_SERVICE_REPOSITORY=https://github.com/leaderscampconnect/api-camping.git
CAMPING_SERVICE_REF=main
EVENT_SERVICE_REPOSITORY=https://github.com/leaderscampconnect/event-service.git
EVENT_SERVICE_REF=main
NOTIFICATION_SERVICE_REPOSITORY=https://github.com/leaderscampconnect/notification-service.git
NOTIFICATION_SERVICE_REF=main

# Development-only local credentials. Change them before any shared deployment.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=campconnect_user_service
POSTGRES_USER=campconnect
POSTGRES_PASSWORD=change-me
POSTGRES_DB=campconnect_camping
RABBITMQ_USER=campconnect
RABBITMQ_PASSWORD=change-me

# External integrations required by api-camping. Use test/sandbox values.
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
APP_JWT_SECRET=replace-with-at-least-32-characters

# Host ports can be changed when another local stack is already running.
FRONTEND_PORT=4200
GATEWAY_PORT=9001
KEYCLOAK_PORT=8180
EUREKA_PORT=8761
CONFIG_SERVER_PORT=8099
EVENT_SERVICE_PORT=8081
NOTIFICATION_SERVICE_PORT=8082
CAMPING_SERVICE_PORT=8083
USER_SERVICE_PORT=8110
MYSQL_PORT=3307
POSTGRES_PORT=5433
EVENT_MONGO_PORT=27017
NOTIFICATION_MONGO_PORT=27018
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
KAFKA_PORT=9092
